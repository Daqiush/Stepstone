{
  "name": "stepstone",
  "version": "1.0.0",
  "description": "Stepstone — 网页端桥牌教学程序",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "postinstall": "node scripts/install-dds.js",
    "test": "node --test test/*.test.js",
    "test:dds:smoke": "node scripts/smoke-dds.js",
    "fixtures:dds": "node scripts/generate-dds-parity-fixtures.js --write",
    "fixtures:dds:refresh-live-sources": "node scripts/generate-dds-parity-fixtures.js --write --refresh-live-sources",
    "test:server:smoke": "node scripts/smoke-server.js"
  },
  "dependencies": {
    "express": "^4.18.2",
    "socket.io": "^4.7.4"
  },
  "devDependencies": {
    "socket.io-client": "4.8.3"
  }
}
