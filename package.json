{
  "name": "stepstone",
  "version": "1.0.0",
  "description": "Stepstone — 网页端桥牌教学程序",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "postinstall": "node scripts/install-dds.js",
    "test": "node --test test/*.test.js",
    "test:workers": "node --test workers/test/*.test.mjs",
    "dev:workers": "wrangler dev --config workers/wrangler.jsonc --local --var DDS_LOCAL_TEST:true",
    "test:dds:smoke": "node scripts/smoke-dds.js",
    "fixtures:dds": "node scripts/generate-dds-parity-fixtures.js --write",
    "fixtures:dds:refresh-live-sources": "node scripts/generate-dds-parity-fixtures.js --write --refresh-live-sources",
    "test:server:smoke": "node scripts/smoke-server.js",
    "benchmark:workers-dds": "node scripts/benchmark-worker-dds.mjs --seed 20260923 --iterations 100000 --url http://127.0.0.1:8787 --out workers/test/results/dds-feasibility.json",
    "simulate:workers-budget": "node scripts/simulate-worker-room-budget.mjs --report workers/test/results/dds-feasibility.json",
    "check:workers-dds": "node scripts/check-worker-dds-gates.mjs --report workers/test/results/dds-feasibility.json",
    "prepare:remote-workers-dds": "node scripts/prepare-remote-dds-deployment.mjs --out workers/test/results/remote-dds-deployment.json",
    "soak:remote-workers-dds": "node scripts/remote-worker-dds-soak.mjs",
    "remote:dds-soak": "node scripts/remote-worker-dds-soak.mjs"
  },
  "dependencies": {
    "express": "^4.18.2",
    "socket.io": "^4.7.4"
  },
  "devDependencies": {
    "socket.io-client": "4.8.3",
    "wrangler": "4.137.0"
  }
}
